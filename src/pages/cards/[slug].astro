---
import SiteLayout from '../../layouts/SiteLayout.astro'
import { displayCards as tarotCards } from '../../data/display'

export function getStaticPaths() {
  return tarotCards.map((card) => ({ params: { slug: card.id }, props: { card } }))
}

const { card } = Astro.props
const base = import.meta.env.BASE_URL
const cardIndex = tarotCards.findIndex((item) => item.id === card.id)
const related = [-1, 1, 2].map((offset) => tarotCards[(cardIndex + offset + tarotCards.length) % tarotCards.length])
---
<SiteLayout title={`${card.name}｜牌义百科｜莫里i的塔罗札记`} description={`${card.name}的正位、逆位、关键词与主题解读。`}>
  <section class="card-detail section-shell">
    <a class="back-link" href={`${base}cards/`}>← 返回牌义百科</a>
    <div class="detail-layout">
      <div class={`detail-card-art ${card.arcana} ${card.suit || ''}`}>
        <div class="detail-card-frame"><span class="detail-number">{card.numberLabel}</span><span class="detail-symbol">{card.symbol}</span><strong>{card.nameEn}</strong><small>{card.name}</small></div>
      </div>
      <div class="detail-copy">
        <p class="eyebrow">{card.arcana === 'major' ? '大阿尔卡那' : `${card.suitName} · 小阿尔卡那`}</p>
        <h1>{card.name}</h1><p class="latin-name">{card.nameEn}</p>
        <p class="card-summary">{card.summary}</p>
        <div class="keyword-row">{card.uprightKeywords.map((keyword) => <span>{keyword}</span>)}</div>
        <div class="meaning-columns">
          <article><div class="meaning-title"><span>↑</span><h2>正位</h2></div><p>{card.uprightMeaning}</p></article>
          <article><div class="meaning-title reversed"><span>↓</span><h2>逆位</h2></div><p>{card.reversedMeaning}</p></article>
        </div>
      </div>
    </div>
    <div class="detail-sections">
      <article class="detail-panel"><p class="eyebrow">放进生活里</p><h2>当你问起感情</h2><p><strong>正位：</strong>{card.loveMeaning}</p><p><strong>逆位：</strong>{card.reversedLoveMeaning}</p><h2>当你问起事业</h2><p><strong>正位：</strong>{card.careerMeaning}</p><p><strong>逆位：</strong>{card.reversedCareerMeaning}</p></article>
      <article class="detail-panel reflection-panel"><p class="eyebrow">给自己的问题</p><h2>这张牌想让你看见什么？</h2><p>不急着寻找唯一答案。把牌面放在今天的情境里，写下第一个浮现的念头：</p><blockquote>“{card.reflection}”</blockquote></article>
    </div>
    <article class="detail-panel symbolism-panel"><p class="eyebrow">读懂画面</p><h2>牌面中的象征</h2><p>{card.symbolism}</p><p><strong>行动提示：</strong>{card.meaning.upright.advice}</p></article>
    <div class="related-cards"><div class="split-heading"><div><p class="eyebrow">继续探索</p><h2>相邻的回声</h2></div><a class="text-link" href={`${base}cards/`}>全部牌面 ↗</a></div><div class="featured-cards">{related.map((item) => <a class="mini-card" href={`${base}cards/${item.id}/`}><div class={`mini-card-art ${item.arcana}`}><span>{item.symbol}</span><small>{item.numberLabel}</small></div><div><strong>{item.name}</strong><small>{item.nameEn}</small></div></a>)}</div></div>
  </section>
</SiteLayout>
